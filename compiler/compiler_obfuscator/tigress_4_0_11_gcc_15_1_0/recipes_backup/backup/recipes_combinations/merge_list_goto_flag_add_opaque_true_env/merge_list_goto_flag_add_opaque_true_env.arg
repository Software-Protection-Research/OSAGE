--Transform=Merge
    --Functions=OSAGE_ASSET_PLACEHOLDER_OSAGE
    --Exclude=main
    --MergeOpaqueStructs=list
    --MergeFlattenDispatch=goto
    --MergeConditionalKinds=flag

--Transform=InitEntropy
    --Functions=OSAGE_INIT_PLACEHOLDER_OSAGE
--Transform=InitOpaque
    --Functions=OSAGE_INIT_PLACEHOLDER_OSAGE
    --InitOpaqueStructs=env
--Transform=AddOpaque
    --Functions=OSAGE_ASSET_PLACEHOLDER_OSAGE
    --AddOpaqueKinds=true
    --AddOpaqueStructs=env