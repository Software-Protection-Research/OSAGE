--Transform=InitEntropy
    --Functions=OSAGE_INIT_PLACEHOLDER_OSAGE
--Transform=InitOpaque
    --Functions=OSAGE_INIT_PLACEHOLDER_OSAGE
    --InitOpaqueStructs=array
--Transform=AddOpaque
    --Functions=OSAGE_ASSET_PLACEHOLDER_OSAGE
    --AddOpaqueKinds=true
    --AddOpaqueStructs=array

--Transform=Merge
    --Functions=OSAGE_ASSET_PLACEHOLDER_OSAGE
    --Exclude=main
    --MergeOpaqueStructs=array
    --MergeFlattenDispatch=indirect
    --MergeConditionalKinds=branch